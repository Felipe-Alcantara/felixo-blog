---
import { caminho } from '../utils/rotas';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icone from '../components/Icone.astro';
---

<BaseLayout titulo="Página não encontrada" descricao="Esta página não existe.">
  <div class="py-16 text-center">
    <p class="text-sm font-semibold uppercase tracking-widest text-felixo-purple">
      Erro 404
    </p>
    <h1 class="felixo-text-glow mt-3 text-4xl font-bold">Esta página não existe</h1>
    <p class="mt-4 text-zinc-400">
      O link pode estar quebrado ou o conteúdo pode ter mudado de lugar.
    </p>
    <a href={caminho('/')} class="felixo-botao mt-8">
      <Icone nome="seta-esquerda" />
      <span>Voltar para a home</span>
    </a>
  </div>
</BaseLayout>
