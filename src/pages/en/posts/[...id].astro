---
// O post em inglês: o texto da tradução (`src/content/traducoes/en/<post>.md`)
// quando ela existe; sem ela, a cópia com o texto em português, a interface em
// inglês e um aviso (ver `PostLayout.astro`).
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import PostLayout from '../../../layouts/PostLayout.astro';
import { buscarTraducao, listarPosts, type Post } from '../../../utils/posts';

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await listarPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
};

interface Props {
  post: Post;
}

const { post } = Astro.props as Props;
const conteudo = (await buscarTraducao(post)) ?? post;
const { Content } = await render(conteudo);
---

<PostLayout post={post} corpo={conteudo.body ?? ''}>
  <Content />
</PostLayout>
