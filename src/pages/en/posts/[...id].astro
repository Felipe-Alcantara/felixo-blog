---
// A cópia em inglês do post: o mesmo texto em português, com a interface em
// inglês e um aviso (ver `PostLayout.astro`). Quando um post ganhar tradução,
// ela entra neste mesmo endereço.
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import PostLayout from '../../../layouts/PostLayout.astro';
import { listarPosts, type Post } from '../../../utils/posts';

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await listarPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
};

interface Props {
  post: Post;
}

const { post } = Astro.props as Props;
const { Content } = await render(post);
---

<PostLayout post={post} corpo={post.body ?? ''}>
  <Content />
</PostLayout>
