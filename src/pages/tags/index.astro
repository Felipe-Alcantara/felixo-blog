---
import { caminho } from '../../utils/rotas';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { listarTags, slugDaTag } from '../../utils/posts';

const tags = await listarTags();
---

<BaseLayout titulo="Tags" descricao="Todos os assuntos abordados no blog do Felixo.">
  <h1 class="felixo-text-glow text-3xl font-bold leading-tight sm:text-4xl">Tags</h1>
  <p class="mt-3 text-zinc-400">Navegue pelos assuntos do blog.</p>

  {
    tags.length === 0 ? (
      <p class="mt-8 text-zinc-400">Nenhuma tag ainda.</p>
    ) : (
      <ul class="mt-8 flex flex-wrap gap-3">
        {tags.map(({ nome, total }) => (
          <li>
            <a
              href={caminho(`/tags/${slugDaTag(nome)}/`)}
              class="inline-flex items-center gap-2 rounded-full border border-purple-500/25 bg-purple-500/10 px-4 py-1.5 text-sm text-felixo-purple transition hover:border-purple-400/50 hover:bg-purple-500/20 hover:shadow-[0_0_18px_rgba(168,85,247,0.3)]"
            >
              {nome}
              <span class="font-mono text-xs text-zinc-400">{total}</span>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>
