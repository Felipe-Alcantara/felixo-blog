---
import { caminho } from '../../utils/rotas';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CartaoPost from '../../components/CartaoPost.astro';
import { listarPosts, slugDaTag, type Post } from '../../utils/posts';

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await listarPosts();
  const porTag = new Map<string, { nome: string; posts: Post[] }>();

  for (const post of posts) {
    for (const tag of post.data.tags) {
      const slug = slugDaTag(tag);
      const grupo = porTag.get(slug) ?? { nome: tag, posts: [] };
      grupo.posts.push(post);
      porTag.set(slug, grupo);
    }
  }

  return [...porTag.entries()].map(([slug, grupo]) => ({
    params: { tag: slug },
    props: grupo,
  }));
};

interface Props {
  nome: string;
  posts: Post[];
}

const { nome, posts } = Astro.props as Props;
---

<BaseLayout titulo={`Tag: ${nome}`} descricao={`Posts do blog do Felixo sobre ${nome}.`}>
  <p class="text-sm font-semibold uppercase tracking-widest text-felixo-purple">Tag</p>
  <h1 class="felixo-text-glow mt-2 text-3xl font-bold sm:text-4xl">{nome}</h1>
  <p class="mt-3 text-zinc-400">
    {posts.length} {posts.length === 1 ? 'post' : 'posts'}
  </p>

  <ul class="mt-8 space-y-5">
    {
      posts.map((post) => (
        <li>
          <CartaoPost post={post} />
        </li>
      ))
    }
  </ul>

  <nav class="mt-12 text-sm">
    <a href={caminho('/tags')} class="text-felixo-purple transition hover:text-white"
      >← Todas as tags</a
    >
  </nav>
</BaseLayout>
