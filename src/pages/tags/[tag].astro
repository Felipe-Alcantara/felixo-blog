---
import type { GetStaticPaths } from 'astro';
import PaginaDaTag from '../../components/PaginaDaTag.astro';
import { agruparPorTag, type Post } from '../../utils/posts';

export const getStaticPaths: GetStaticPaths = async () =>
  (await agruparPorTag('pt')).map(({ slug, nome, posts }) => ({
    params: { tag: slug },
    props: { nome, posts },
  }));

interface Props {
  nome: string;
  posts: Post[];
}

const { nome, posts } = Astro.props as Props;
---

<PaginaDaTag idioma="pt" nome={nome} posts={posts} />
