---
import BaseLayout from '../layouts/BaseLayout.astro';
import CartaoPost from '../components/CartaoPost.astro';
import Icone from '../components/Icone.astro';
import { caminho } from '../utils/rotas';
import { SITE } from '../config/site';
import { listarPosts } from '../utils/posts';

const posts = await listarPosts();
---

<BaseLayout titulo={SITE.titulo}>
  <section class="mx-auto max-w-5xl pb-16">
    <p class="text-sm font-semibold uppercase tracking-widest text-felixo-purple">
      FelixoVerse
    </p>
    <h1 class="felixo-text-glow mt-3 max-w-4xl text-4xl font-bold sm:text-5xl">
      Programação descomplicada
    </h1>
    <!-- Chamada própria, não `SITE.descricao`: a descrição começa com as mesmas
         palavras do título, e reusá-la aqui fazia "Programação descomplicada"
         aparecer duas vezes seguidas na primeira dobra. -->
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-zinc-400">
      {SITE.chamada}
    </p>

    <div class="mt-6 flex flex-wrap gap-3">
      <a href="#titulo-posts" class="felixo-botao">
        <Icone nome="seta-baixo" />
        <span>Ver posts</span>
      </a>
      <a
        href="https://felixo.com.br/"
        target="_blank"
        rel="noopener noreferrer"
        class="felixo-botao"
      >
        <Icone nome="link-externo" />
        <span>Ver portfólio</span>
      </a>
      <a href={caminho('/rss.xml')} class="felixo-botao felixo-botao-fantasma">
        <Icone nome="rss" />
        <span>Assinar RSS</span>
      </a>
    </div>
  </section>

  <section class="mx-auto max-w-5xl" aria-labelledby="titulo-posts">
    <h2
      id="titulo-posts"
      class="border-t border-white/5 pt-8 text-sm font-semibold uppercase tracking-widest text-zinc-400"
    >
      Posts
    </h2>

    {
      posts.length === 0 ? (
        <p class="mt-6 text-zinc-400">Nenhum post publicado ainda. Em breve.</p>
      ) : (
        <ul class="mt-6 space-y-5">
          {posts.map((post) => (
            <li>
              <CartaoPost post={post} />
            </li>
          ))}
        </ul>
      )
    }
  </section>
</BaseLayout>
