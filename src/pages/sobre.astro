---
import { caminho } from '../utils/rotas';
import BaseLayout from '../layouts/BaseLayout.astro';
import BotaoAssinatura from '../components/BotaoAssinatura.astro';
import { SITE } from '../config/site';
import { TEXTOS } from '../config/idiomas';
---

<BaseLayout titulo="Sobre" descricao={`Sobre ${SITE.autor} e o ${SITE.titulo}.`}>
  <section class="grid items-start gap-8 sm:grid-cols-[160px_minmax(0,1fr)] sm:gap-10">
    <!-- Foto sem halos de brilho nem moldura dupla: numa página sobre uma
         pessoa, o retrato não precisa de efeito para chamar atenção. -->
    <img
      src={caminho('/imagens/foto-felipe.jpg')}
      alt={`Retrato de ${SITE.autor}`}
      width="720"
      height="1089"
      loading="eager"
      decoding="async"
      class="aspect-square w-40 rounded-2xl border border-white/10 object-cover object-top sm:w-full"
    />

    <div>
      <h1 class="felixo-text-glow text-3xl font-bold leading-tight sm:text-4xl">Sobre</h1>

      <div class="conteudo-post mt-8">
        <!-- Os mesmos parágrafos da home, ditados pelo dono (2026-10-26): o Sobre e a
             home dizem a mesma coisa porque o texto é um só. -->
        {TEXTOS.pt.home.apresentacao.map((paragrafo) => <p>{paragrafo}</p>)}

        <h2>Onde mais me encontrar</h2>

        <ul>
          <li>
            Portfólio: <a
              href="https://felixo.com.br/"
              target="_blank"
              rel="noopener noreferrer">felixo.com.br</a
            >
          </li>
          <li>
            GitHub: <a
              href="https://github.com/Felipe-Alcantara"
              target="_blank"
              rel="noopener noreferrer">@Felipe-Alcantara</a
            >
          </li>
          <li>
            Feed RSS: <a href={caminho('/rss.xml')}>/rss.xml</a>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <BotaoAssinatura idioma="pt" variante="chamada" class="mt-14" />
</BaseLayout>
