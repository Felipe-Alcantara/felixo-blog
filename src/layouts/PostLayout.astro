---
import { getImage } from 'astro:assets';
import { caminho, caminhoSemBase } from '../utils/rotas';
import { TEXTOS, idiomaDoCaminho } from '../config/idiomas';
import { GOATCOUNTER } from '../config/site';
import BaseLayout from './BaseLayout.astro';
import AcessosDoPost from '../components/AcessosDoPost.astro';
import BotaoAssinatura from '../components/BotaoAssinatura.astro';
import Comentarios from '../components/Comentarios.astro';
import Etiqueta from '../components/Etiqueta.astro';
import Icone from '../components/Icone.astro';
import { formatarDataISO, formatarDataLonga, tempoDeLeitura } from '../utils/datas';
import { buscarTraducao, versaoDoPost, type Post } from '../utils/posts';

interface Props {
  post: Post;
  /** Corpo bruto em Markdown, usado só para estimar o tempo de leitura. */
  corpo: string;
}

const { post, corpo } = Astro.props;
const { publicadoEm, atualizadoEm, capa } = post.data;
const minutos = tempoDeLeitura(corpo);
const idioma = idiomaDoCaminho(caminhoSemBase(Astro.url));
const textos = TEXTOS[idioma];
// A tradução existe quando há `src/content/traducoes/en/<post>.md`. A página em
// inglês usa o texto dela; sem ela, é a cópia com a interface em inglês, o
// texto em português e um aviso. A data e a capa são sempre as do original.
const traducaoDoPost = await buscarTraducao(post);
const { traducao, titulo, descricao, tags } = versaoDoPost(post, traducaoDoPost, idioma);
const emIngles = idioma === 'en';
const copiaEmPortugues = emIngles && !traducao;
const semRevisao = traducao !== undefined && !traducao.data.revisado;

// Capa em tamanho de cartão Open Graph (1200×630) — mesma proporção do
// cartão genérico gerado por `scripts/gerar-og-image.py`.
const capaOtimizada = capa
  ? await getImage({ src: capa, width: 1200, height: 630, fit: 'cover' })
  : undefined;
const imagemCapa = capaOtimizada
  ? { src: capaOtimizada.src, width: 1200, height: 630 }
  : undefined;
---

<BaseLayout
  titulo={titulo}
  descricao={descricao}
  tipoOG="article"
  publicadoEm={publicadoEm}
  imagemCapa={imagemCapa}
  semTraducao={!traducaoDoPost}
>
  {
    copiaEmPortugues && (
      <p
        role="note"
        class="mb-8 rounded-lg border border-white/10 bg-white/5 px-4 py-3 text-sm text-zinc-300"
      >
        {textos.post.avisoSoPortugues}
      </p>
    )
  }
  {
    semRevisao && (
      <p
        role="note"
        class="mb-8 rounded-lg border border-white/10 bg-white/5 px-4 py-3 text-sm text-zinc-300"
      >
        {textos.post.avisoSemRevisao}{' '}
        <a
          href={caminho(`/posts/${post.id}/`)}
          hreflang="pt-BR"
          class="text-felixo-purple underline decoration-purple-400/35 underline-offset-4 transition hover:text-white"
        >
          {textos.post.lerOriginal}
        </a>
        .
      </p>
    )
  }

  <article lang={copiaEmPortugues ? 'pt-BR' : undefined}>
    <header class="border-b border-white/5 pb-8">
      <h1 class="felixo-text-glow text-3xl font-bold leading-tight sm:text-4xl">
        {titulo}
      </h1>
      <p class="mt-3 text-lg leading-relaxed text-zinc-400">{descricao}</p>

      <div
        lang={textos.lang}
        class="mt-5 flex flex-wrap items-center gap-3 text-sm text-zinc-400"
      >
        <time datetime={formatarDataISO(publicadoEm)}>
          {formatarDataLonga(publicadoEm, textos.localeDatas)}
        </time>
        <span aria-hidden="true">·</span>
        <span>{minutos} {textos.post.minLeitura}</span>
        {
          atualizadoEm && (
            <>
              <span aria-hidden="true">·</span>
              <span>
                {textos.post.atualizadoEm}{' '}
                {formatarDataLonga(atualizadoEm, textos.localeDatas)}
              </span>
            </>
          )
        }
        {GOATCOUNTER.codigo !== '' && <AcessosDoPost idioma={idioma} />}
      </div>

      {
        tags.length > 0 && (
          <ul class="mt-4 flex flex-wrap gap-2">
            {tags.map((tag) => (
              <li>
                <Etiqueta
                  tag={tag}
                  idioma={idioma}
                  lang={copiaEmPortugues ? 'pt-BR' : undefined}
                />
              </li>
            ))}
          </ul>
        )
      }
    </header>

    <div class="conteudo-post mt-10">
      <slot />
    </div>
  </article>

  <BotaoAssinatura idioma={idioma} variante="chamada" class="mt-16" />

  <div>
    <Comentarios idioma={idioma} />

    <nav class="mt-16 border-t border-white/5 pt-6 text-sm">
      <a
        href={caminho(emIngles ? '/en/' : '/')}
        class="inline-flex items-center gap-2 text-felixo-purple underline decoration-purple-400/35 underline-offset-4 transition hover:text-white"
      >
        <Icone nome="seta-esquerda" />
        <span>{textos.post.voltar}</span>
      </a>
    </nav>
  </div>
</BaseLayout>
