---
import { getImage } from 'astro:assets';
import { caminho } from '../utils/rotas';
import BaseLayout from './BaseLayout.astro';
import Comentarios from '../components/Comentarios.astro';
import Etiqueta from '../components/Etiqueta.astro';
import Icone from '../components/Icone.astro';
import { formatarDataISO, formatarDataLonga, tempoDeLeitura } from '../utils/datas';
import { type Post } from '../utils/posts';

interface Props {
  post: Post;
  /** Corpo bruto em Markdown, usado só para estimar o tempo de leitura. */
  corpo: string;
}

const { post, corpo } = Astro.props;
const { titulo, descricao, publicadoEm, atualizadoEm, tags, capa } = post.data;
const minutos = tempoDeLeitura(corpo);

// Capa em tamanho de cartão Open Graph (1200×630) — mesma proporção do
// cartão genérico gerado por `scripts/gerar-og-image.py`.
const capaOtimizada = capa
  ? await getImage({ src: capa, width: 1200, height: 630, fit: 'cover' })
  : undefined;
const imagemCapa = capaOtimizada
  ? { src: capaOtimizada.src, width: 1200, height: 630 }
  : undefined;
---

<BaseLayout
  titulo={titulo}
  descricao={descricao}
  tipoOG="article"
  publicadoEm={publicadoEm}
  imagemCapa={imagemCapa}
>
  <article class="mx-auto max-w-3xl">
    <header class="border-b border-white/5 pb-8">
      <h1 class="felixo-text-glow text-3xl font-bold sm:text-4xl">{titulo}</h1>
      <p class="mt-3 text-lg leading-relaxed text-zinc-400">{descricao}</p>

      <div class="mt-5 flex flex-wrap items-center gap-3 text-sm text-zinc-400">
        <time datetime={formatarDataISO(publicadoEm)}>
          {formatarDataLonga(publicadoEm)}
        </time>
        <span aria-hidden="true">·</span>
        <span>{minutos} min de leitura</span>
        {
          atualizadoEm && (
            <>
              <span aria-hidden="true">·</span>
              <span>atualizado em {formatarDataLonga(atualizadoEm)}</span>
            </>
          )
        }
      </div>

      {
        tags.length > 0 && (
          <ul class="mt-4 flex flex-wrap gap-2 text-xs">
            {tags.map((tag) => (
              <li>
                <Etiqueta tag={tag} />
              </li>
            ))}
          </ul>
        )
      }
    </header>

    <div class="conteudo-post mt-10">
      <slot />
    </div>
  </article>

  <div class="mx-auto max-w-3xl">
    <Comentarios />

    <nav class="mt-16 border-t border-white/5 pt-6 text-sm">
      <a
        href={caminho('/')}
        class="inline-flex items-center gap-2 text-felixo-purple transition hover:text-white"
      >
        <Icone nome="seta-esquerda" />
        <span>Voltar para todos os posts</span>
      </a>
    </nav>
  </div>
</BaseLayout>
