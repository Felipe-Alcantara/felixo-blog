---
import { caminho, caminhoSemBase } from '../utils/rotas';
import Cabecalho from '../components/Cabecalho.astro';
import Rodape from '../components/Rodape.astro';
import EscolhaDeIdioma from '../components/EscolhaDeIdioma.astro';
import RedirecionarParaIngles from '../components/RedirecionarParaIngles.astro';
import { SITE } from '../config/site';
import { TEXTOS, idiomaDoCaminho, paginaEquivalente } from '../config/idiomas';
import '../styles/global.css';

interface Props {
  titulo: string;
  descricao?: string;
  /** Tipo Open Graph: `website` para páginas, `article` para posts. */
  tipoOG?: 'website' | 'article';
  publicadoEm?: Date;
  /** Capa do post (já otimizada pelo Astro), quando o post tiver uma. */
  imagemCapa?: { src: string; width: number; height: number };
}

// O idioma sai do caminho: tudo em `/en/` é inglês, o resto é português.
const atual = caminhoSemBase(Astro.url);
const idioma = idiomaDoCaminho(atual);
const textos = TEXTOS[idioma];

const {
  titulo,
  descricao = textos.descricao,
  tipoOG = 'website',
  publicadoEm,
  imagemCapa,
} = Astro.props;

const tituloCompleto =
  titulo === textos.tituloSite ? titulo : `${titulo} · ${textos.tituloSite}`;

// A mesma página nos dois idiomas, quando existe: vira `hreflang` para o
// buscador e destino da pergunta da primeira visita.
const equivalentes = {
  pt: paginaEquivalente(atual, 'pt'),
  en: paginaEquivalente(atual, 'en'),
};
const temOsDois = Boolean(equivalentes.pt && equivalentes.en);
const absoluta = (rota: string) => new URL(caminho(rota), Astro.site ?? SITE.url);

// Quem já escolheu inglês e abre a home em português vai direto para `/en/`.
// Só na home: um link compartilhado para uma página específica é respeitado.
const redirecionarSeEscolheuIngles = idioma === 'pt' && atual === '/';
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url);

// Cartão de compartilhamento. A URL precisa ser absoluta: WhatsApp, LinkedIn e
// X buscam a imagem a partir do HTML cru, sem resolver caminho relativo. Post
// com capa própria usa ela; sem capa, cai no cartão genérico do site (gerado
// por `scripts/gerar-og-image.py`).
const imagemCompartilhamento = imagemCapa
  ? new URL(imagemCapa.src, Astro.site ?? SITE.url)
  : new URL(caminho('/og-image.jpg'), Astro.site ?? SITE.url);
---

<!doctype html>
<html lang={textos.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {redirecionarSeEscolheuIngles && <RedirecionarParaIngles />}
    <title>{tituloCompleto}</title>
    <meta name="description" content={descricao} />
    <meta name="author" content={SITE.autor} />
    <link rel="canonical" href={canonical} />
    {
      temOsDois && (
        <>
          <link rel="alternate" hreflang="pt-BR" href={absoluta(equivalentes.pt!)} />
          <link rel="alternate" hreflang="en" href={absoluta(equivalentes.en!)} />
          <link rel="alternate" hreflang="x-default" href={absoluta(equivalentes.pt!)} />
        </>
      )
    }
    <link rel="icon" type="image/svg+xml" href={caminho('/favicon.svg')} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE.titulo}
      href={caminho('/rss.xml')}
    />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content={tipoOG} />
    <meta property="og:site_name" content={textos.tituloSite} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={textos.localeOG} />
    {
      temOsDois && (
        <meta
          property="og:locale:alternate"
          content={TEXTOS[idioma === 'pt' ? 'en' : 'pt'].localeOG}
        />
      )
    }
    <meta property="og:image" content={imagemCompartilhamento} />
    <meta property="og:image:width" content={String(imagemCapa?.width ?? 1200)} />
    <meta property="og:image:height" content={String(imagemCapa?.height ?? 630)} />
    <meta
      property="og:image:alt"
      content={`${textos.tituloSite} — ${textos.descricao}`}
    />
    {
      publicadoEm && (
        <meta property="article:published_time" content={publicadoEm.toISOString()} />
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={SITE.twitter} />
    <meta name="twitter:title" content={tituloCompleto} />
    <meta name="twitter:description" content={descricao} />
    <meta name="twitter:image" content={imagemCompartilhamento} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=JetBrains+Mono:wght@400;500&display=swap"
    />
  </head>

  <body class="relative min-h-dvh text-zinc-300 antialiased">
    <div class="felixo-ambiente" aria-hidden="true"></div>
    <a
      href="#conteudo"
      class="relative z-50 sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:rounded-lg focus:bg-purple-600 focus:px-4 focus:py-2 focus:text-white"
      >{textos.pularParaConteudo}</a
    >
    <Cabecalho idioma={idioma} />
    <main id="conteudo" class="relative z-10 mx-auto max-w-3xl px-4 py-14 sm:px-6">
      <slot />
    </main>
    <Rodape idioma={idioma} />
    <EscolhaDeIdioma
      idioma={idioma}
      destinos={{
        pt: equivalentes.pt && caminho(equivalentes.pt),
        en: equivalentes.en && caminho(equivalentes.en),
      }}
    />
  </body>
</html>
