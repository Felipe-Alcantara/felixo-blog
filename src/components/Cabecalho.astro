---
import { caminho } from '../utils/rotas';
import { LINKS_NAVEGACAO, SITE } from '../config/site';

// Descarta o prefixo `base` para comparar com os hrefs de navegação, que são
// escritos a partir da raiz do site ("/", "/tags"...).
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const caminhoAtual = Astro.url.pathname.slice(base.length) || '/';
---

<header class="relative z-40">
  <!-- `flex-wrap`: em 360px a marca e os três links não cabem na mesma linha, e
       o último ficava cortado na borda da tela. Quebrar para a linha de baixo
       mantém tudo alcançável sem esconder o nome do blog nem virar um trilho
       de rolagem horizontal, que ninguém percebe que rola. -->
  <nav
    class="mx-auto flex max-w-3xl flex-wrap items-center justify-between gap-x-6 gap-y-3 px-4 pt-8 pb-2 sm:px-6"
    aria-label="Navegação principal"
  >
    <a
      href={caminho('/')}
      class="group inline-flex shrink-0 items-center gap-2.5 font-bold text-zinc-100"
    >
      <!-- O gato fica sozinho, sem caixa com borda e brilho em volta: o brilho
           aparece só no hover, como acento da marca. -->
      <img
        src={caminho('/imagens/logo-felixo.png')}
        alt=""
        width="32"
        height="32"
        decoding="async"
        class="size-8 object-contain transition group-hover:drop-shadow-[0_0_10px_rgba(168,85,247,0.6)]"
      />
      <span>{SITE.titulo}</span>
    </a>

    <ul class="flex items-center gap-5 text-sm">
      {
        LINKS_NAVEGACAO.map(({ rotulo, href }) => {
          const ativo =
            href === '/' ? caminhoAtual === '/' : caminhoAtual.startsWith(href);
          return (
            <li>
              <a
                href={caminho(href)}
                aria-current={ativo ? 'page' : undefined}
                class:list={[
                  'transition',
                  ativo
                    ? 'text-felixo-purple underline decoration-felixo-purple/50 underline-offset-[6px]'
                    : 'text-zinc-400 hover:text-zinc-100',
                ]}
              >
                {rotulo}
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>
</header>
