---
import { caminho } from '../utils/rotas';
import { LINKS_NAVEGACAO, SITE } from '../config/site';

// Descarta o prefixo `base` para comparar com os hrefs de navegação, que são
// escritos a partir da raiz do site ("/", "/tags"...).
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const caminhoAtual = Astro.url.pathname.slice(base.length) || '/';
---

<header class="sticky top-0 z-40 border-b border-white/5 bg-black/70 backdrop-blur-md">
  <nav
    class="mx-auto flex max-w-3xl items-center justify-between gap-4 px-4 py-4"
    aria-label="Navegação principal"
  >
    <a
      href={caminho('/')}
      class="group inline-flex items-center gap-2 text-sm font-bold tracking-wide text-zinc-100"
    >
      <span
        class="grid size-8 place-items-center rounded-lg border border-purple-500/30 bg-purple-500/10 text-felixo-purple shadow-[0_0_15px_rgba(168,85,247,0.3)] transition group-hover:bg-purple-500/20 group-hover:shadow-[0_0_22px_rgba(168,85,247,0.5)]"
        aria-hidden="true">F</span
      >
      <span>{SITE.titulo}</span>
    </a>

    <ul class="flex items-center gap-1 text-sm">
      {
        LINKS_NAVEGACAO.map(({ rotulo, href }) => {
          const ativo =
            href === '/' ? caminhoAtual === '/' : caminhoAtual.startsWith(href);
          return (
            <li>
              <a
                href={caminho(href)}
                aria-current={ativo ? 'page' : undefined}
                class:list={[
                  'rounded-lg px-3 py-1.5 transition',
                  ativo
                    ? 'bg-purple-500/10 text-felixo-purple'
                    : 'text-zinc-400 hover:bg-white/5 hover:text-zinc-100',
                ]}
              >
                {rotulo}
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>
</header>
