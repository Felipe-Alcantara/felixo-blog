---
/**
 * Comentários do post via giscus (GitHub Discussions).
 * Sem backend próprio: os dados moram nas Discussions do repositório
 * felixo-blog. Ver GISCUS em src/config/site.ts para os IDs.
 */
import { GISCUS } from '../config/site';
import { TEXTOS, type Idioma } from '../config/idiomas';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const textos = TEXTOS[idioma].comentarios;
---

<section class="mt-16 border-t border-white/5 pt-10" aria-labelledby="comentarios-titulo">
  <h2 id="comentarios-titulo" class="felixo-text-glow text-xl font-bold">
    {textos.titulo}
  </h2>
  <p class="mt-2 text-sm text-zinc-400">
    {textos.antes}{' '}
    <a
      href={`https://github.com/${GISCUS.repo}/discussions`}
      class="text-felixo-purple underline decoration-purple-500/40 underline-offset-2 transition hover:text-white"
      target="_blank"
      rel="noopener noreferrer">{textos.link}</a
    >.
  </p>

  <div class="mt-6">
    <script
      is:inline
      src="https://giscus.app/client.js"
      data-repo={GISCUS.repo}
      data-repo-id={GISCUS.repoId}
      data-category={GISCUS.categoria}
      data-category-id={GISCUS.categoriaId}
      data-mapping={GISCUS.mapeamento}
      data-strict="0"
      data-reactions-enabled="1"
      data-emit-metadata="0"
      data-input-position="top"
      data-theme={GISCUS.temaUrl}
      data-lang={idioma === 'en' ? 'en' : GISCUS.idioma}
      data-loading="lazy"
      crossorigin="anonymous"
      async></script>
    <noscript>
      <p class="text-sm text-zinc-400">{textos.semJs}</p>
    </noscript>
  </div>
</section>
