---
/**
 * Home do blog, a mesma nos dois idiomas: `src/pages/index.astro` (português)
 * e `src/pages/en/index.astro` (inglês) só escolhem o idioma. Os textos vêm de
 * `src/config/idiomas.ts`.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import ItemPost from './ItemPost.astro';
import Icone from './Icone.astro';
import { caminho } from '../utils/rotas';
import { TEXTOS, type Idioma } from '../config/idiomas';
import { listarPosts } from '../utils/posts';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const textos = TEXTOS[idioma];
const posts = await listarPosts();
---

<BaseLayout titulo={textos.tituloSite}>
  <section class="pb-14">
    <!-- Apresentação em primeira pessoa, no lugar do slogan "Programação
         descomplicada", que servia para qualquer blog (2026-09-30). O texto é
         do dono, em `TEXTOS.<idioma>.home`. -->
    <h1 class="felixo-text-glow text-4xl font-bold leading-tight sm:text-5xl">
      {textos.home.titulo}
    </h1>
    <div class="mt-4 space-y-3 text-lg leading-relaxed text-zinc-400">
      {textos.home.apresentacao.map((paragrafo) => <p>{paragrafo}</p>)}
    </div>

    <!-- Botões em pílula do felixo.com.br. Eram três; o "Ver posts" saiu
         porque só rolava até a lista logo abaixo (2026-09-30). -->
    <div class="mt-7 flex flex-wrap gap-3">
      <a
        href="https://felixo.com.br/"
        target="_blank"
        rel="noopener noreferrer"
        class="felixo-botao"
      >
        <Icone nome="link-externo" />
        <span>{textos.home.verPortfolio}</span>
      </a>
      <a href={caminho('/rss.xml')} class="felixo-botao felixo-botao-fantasma">
        <Icone nome="rss" />
        <span>{textos.home.assinarRss}</span>
      </a>
    </div>
  </section>

  <section aria-labelledby="titulo-posts">
    <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-4">
      <h2 id="titulo-posts" class="felixo-text-glow text-2xl font-bold">
        {textos.home.posts}
      </h2>

      {
        posts.length > 0 && (
          <div class="felixo-busca w-full sm:w-64" role="search">
            <label for="busca-posts" class="sr-only">
              {textos.home.pesquisarPosts}
            </label>
            <Icone nome="busca" tamanho={16} />
            <input
              type="search"
              id="busca-posts"
              placeholder={textos.home.pesquisar}
              autocomplete="off"
              aria-controls="lista-posts"
            />
          </div>
        )
      }
    </div>

    {
      posts.length === 0 ? (
        <p class="mt-6 text-zinc-400">{textos.home.nenhumPost}</p>
      ) : (
        <>
          <ul id="lista-posts" class="mt-10 space-y-10">
            {posts.map((post) => (
              <li
                data-busca={[post.data.titulo, post.data.descricao, ...post.data.tags]
                  .join(' ')
                  .toLowerCase()}
              >
                <ItemPost post={post} idioma={idioma} />
              </li>
            ))}
          </ul>

          <p
            id="busca-sem-resultado"
            class="mt-6 hidden text-zinc-400"
            aria-live="polite"
          >
            {textos.home.nenhumResultado}
          </p>
        </>
      )
    }
  </section>
</BaseLayout>

<script>
  // Filtro client-side dos posts já renderizados: sem framework, sem
  // dependência nova, só o vanilla JS necessário para a barra de pesquisa.
  const campo = document.querySelector<HTMLInputElement>('#busca-posts');
  const itens = document.querySelectorAll<HTMLLIElement>('#lista-posts > li');
  const semResultado =
    document.querySelector<HTMLParagraphElement>('#busca-sem-resultado');

  campo?.addEventListener('input', () => {
    const termo = campo.value.trim().toLowerCase();
    let algumVisivel = false;

    itens.forEach((item) => {
      const corresponde = !termo || (item.dataset.busca ?? '').includes(termo);
      item.classList.toggle('hidden', !corresponde);
      if (corresponde) algumVisivel = true;
    });

    semResultado?.classList.toggle('hidden', algumVisivel);
  });
</script>
