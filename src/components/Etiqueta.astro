---
/**
 * Etiqueta de tag: a pílula roxa que leva para a página do assunto, no mesmo
 * desenho das etiquetas de categoria do felixo.com.br ("Web", "Python").
 *
 * Em 2026-09-30 saiu a caixa alta com espaçamento largo, que gritava mais do
 * que a informação pedia; a pílula ficou. Existe como componente porque
 * aparece na lista de posts e no cabeçalho do post, e duas cópias do mesmo
 * estilo divergem no primeiro ajuste.
 */
import { caminho } from '../utils/rotas';
import { slugDaTag } from '../utils/posts';

interface Props {
  tag: string;
}

const { tag } = Astro.props;
---

<a
  href={caminho(`/tags/${slugDaTag(tag)}/`)}
  class="inline-block rounded-full border border-purple-500/25 bg-purple-500/10 px-2.5 py-0.5 text-xs font-medium text-felixo-purple transition hover:border-purple-400/50 hover:bg-purple-500/20"
>
  {tag}
</a>
