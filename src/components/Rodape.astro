---
import { LINKS_EXTERNOS, SITE } from '../config/site';

const ano = new Date().getFullYear();
---

<footer class="mt-24 border-t border-white/5">
  <div
    class="mx-auto flex max-w-3xl flex-col gap-4 px-4 py-10 text-sm text-zinc-500 sm:flex-row sm:items-center sm:justify-between"
  >
    <p>© {ano} {SITE.autor}. Feito com Astro.</p>
    <ul class="flex flex-wrap gap-4">
      {
        LINKS_EXTERNOS.map(({ rotulo, href }) => (
          <li>
            <a
              href={href}
              class="transition hover:text-felixo-purple"
              rel={href.startsWith('http') ? 'noopener noreferrer' : undefined}
              target={href.startsWith('http') ? '_blank' : undefined}
            >
              {rotulo}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
