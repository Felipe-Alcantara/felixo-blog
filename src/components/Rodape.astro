---
import { FOLLOWIT, SITE } from '../config/site';
import { TEXTOS, type Idioma } from '../config/idiomas';
import { caminho } from '../utils/rotas';
import BotaoAssinatura from './BotaoAssinatura.astro';
import AcessosNoRodape from './AcessosNoRodape.astro';
import PausarAnimacoes from './PausarAnimacoes.astro';

interface Props {
  idioma: Idioma;
  /** Mostra o número da página junto com o total do blog (ver `AcessosNoRodape`). */
  acessosDaPagina?: boolean;
}

const { acessosDaPagina = true } = Astro.props;
const textos = TEXTOS[Astro.props.idioma];

const ano = new Date().getFullYear();

/** Links externos vão como estão; os internos precisam do prefixo `base`. */
const ehExterno = (href: string) => href.startsWith('http');
---

<footer class="relative z-10 mt-24">
  <!-- A linha fica no bloco de dentro para ter a mesma largura do texto,
       não a largura do padding lateral. -->
  <div class="mx-auto max-w-3xl px-4 sm:px-6">
    <div
      class="flex flex-col gap-4 border-t border-white/5 py-10 text-sm text-zinc-400 sm:flex-row sm:items-center sm:justify-between"
    >
      <div class="flex flex-col gap-1.5">
        <p>© {ano} {SITE.autor}. {textos.feitoCom}</p>
        <AcessosNoRodape idioma={Astro.props.idioma} daPagina={acessosDaPagina} />
      </div>
      <ul class="flex flex-wrap gap-4">
        {
          textos.linksExternos.map(({ rotulo, href }) => (
            <li>
              <a
                href={ehExterno(href) ? href : caminho(href)}
                class="transition hover:text-felixo-purple"
                rel={ehExterno(href) ? 'noopener noreferrer' : undefined}
                target={ehExterno(href) ? '_blank' : undefined}
              >
                {rotulo}
              </a>
            </li>
          ))
        }
        {/* Para as animações; só aparece com JavaScript e sem "reduzir movimento". */}
        <PausarAnimacoes idioma={Astro.props.idioma} />
        {/* Abre a janela de assinatura; sem `li` vazio quando ela está desligada. */}
        {
          FOLLOWIT.formulario !== '' && (
            <li>
              <BotaoAssinatura idioma={Astro.props.idioma} variante="link" />
            </li>
          )
        }
      </ul>
    </div>
  </div>
</footer>
