---
/**
 * Lista de todas as tags, a mesma nos dois idiomas: `src/pages/tags/index.astro`
 * (português) e `src/pages/en/tags/index.astro` (inglês) só escolhem o idioma.
 * Os nomes das tags são sempre em português, como os posts.
 */
import { caminho } from '../utils/rotas';
import BaseLayout from '../layouts/BaseLayout.astro';
import { TEXTOS, type Idioma } from '../config/idiomas';
import { listarTags, slugDaTag } from '../utils/posts';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const textos = TEXTOS[idioma].tags;
const prefixo = idioma === 'en' ? '/en' : '';
const tags = await listarTags(idioma);
---

<BaseLayout titulo={textos.titulo} descricao={textos.descricao}>
  <h1 class="felixo-text-glow text-3xl font-bold leading-tight sm:text-4xl">
    {textos.titulo}
  </h1>
  <p class="mt-3 text-zinc-400">{textos.chamada}</p>

  {
    tags.length === 0 ? (
      <p class="mt-8 text-zinc-400">{textos.nenhuma}</p>
    ) : (
      <ul class="mt-8 flex flex-wrap gap-3">
        {tags.map(({ nome, total, traduzida }) => (
          <li>
            <a
              href={caminho(`${prefixo}/tags/${slugDaTag(nome)}/`)}
              lang={idioma === 'en' && !traduzida ? 'pt-BR' : undefined}
              class="inline-flex items-center gap-2 rounded-full border border-purple-500/25 bg-purple-500/10 px-4 py-1.5 text-sm text-felixo-purple transition hover:border-purple-400/50 hover:bg-purple-500/20 hover:shadow-[0_0_18px_rgba(168,85,247,0.3)]"
            >
              {nome}
              <span class="font-mono text-xs text-zinc-400">{total}</span>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>
