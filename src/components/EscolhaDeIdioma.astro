---
/**
 * Pergunta de idioma na primeira visita (decisão do dono, 2026-09-30): abre
 * uma vez, guarda a escolha no `localStorage` e não pergunta de novo. Depois
 * disso, a troca é pelo seletor PT | EN do cabeçalho.
 *
 * Usa o `<dialog>` nativo, que já prende o foco e fecha com Esc. Sem
 * JavaScript, ou com o armazenamento do navegador bloqueado, a pergunta não
 * aparece: sem ter onde guardar a resposta, ela voltaria a cada página.
 */
import { CHAVE_IDIOMA, type Idioma } from '../config/idiomas';

interface Props {
  /** Idioma da página atual. */
  idioma: Idioma;
  /** A mesma página em cada idioma (já com o `base`), quando existe. */
  destinos: { pt?: string; en?: string };
}

const { idioma, destinos } = Astro.props;
const soEmPortugues = idioma === 'pt' && !destinos.en;
---

<dialog
  id="escolha-idioma"
  aria-labelledby="escolha-idioma-titulo"
  data-chave={CHAVE_IDIOMA}
  data-idioma-da-pagina={idioma}
  data-destino-pt={destinos.pt}
  data-destino-en={destinos.en}
  class="m-auto w-[calc(100%-2rem)] max-w-md rounded-2xl border border-purple-500/30 bg-zinc-950 p-6 text-zinc-300 shadow-[0_0_40px_rgba(168,85,247,0.25)] backdrop:bg-black/70 backdrop:backdrop-blur-sm sm:p-8"
>
  <h2 id="escolha-idioma-titulo" class="text-lg font-bold text-zinc-100">
    <span lang="pt-BR" class="block">Em qual idioma você quer ler?</span>
    <span lang="en" class="mt-1 block text-zinc-400">Which language would you like?</span>
  </h2>

  <div class="mt-6 flex flex-wrap gap-3">
    <button type="button" data-idioma="pt" lang="pt-BR" class="felixo-botao">
      <span>Português</span>
    </button>
    <button
      type="button"
      data-idioma="en"
      lang="en"
      class="felixo-botao felixo-botao-fantasma"
    >
      <span>English</span>
    </button>
  </div>

  {
    soEmPortugues && (
      <p lang="en" class="mt-4 text-sm text-zinc-400">
        This page is only in Portuguese for now.
      </p>
    )
  }
</dialog>

<script>
  const dialogo = document.querySelector<HTMLDialogElement>('#escolha-idioma');
  const chave = dialogo?.dataset.chave ?? '';
  const idiomaDaPagina = dialogo?.dataset.idiomaDaPagina;

  // `localStorage` pode não existir ou lançar erro (aba anônima, bloqueio).
  let armazenamento: Storage | null = null;
  try {
    localStorage.setItem(`${chave}:teste`, '1');
    localStorage.removeItem(`${chave}:teste`);
    armazenamento = localStorage;
  } catch {
    armazenamento = null;
  }

  const salvar = (valor: string | undefined) => {
    if (!valor) return;
    try {
      armazenamento?.setItem(chave, valor);
    } catch {
      // Sem onde guardar, a escolha vale só para esta página.
    }
  };

  // O seletor PT | EN do cabeçalho também grava a escolha; sem isso, a home em
  // português mandaria de volta para `/en/` quem já tinha escolhido inglês.
  document.addEventListener('click', (evento) => {
    const alvo = evento.target instanceof Element ? evento.target : null;
    const link = alvo?.closest<HTMLElement>('[data-trocar-idioma]');
    if (link) salvar(link.dataset.trocarIdioma);
  });

  if (dialogo && armazenamento && !armazenamento.getItem(chave)) {
    // O `<dialog>` modal fica acima de tudo e cobriria o gatinho, então a
    // pergunta espera a abertura começar a sumir (`abertura-sumir`, em
    // `Abertura.astro`). Abrir nesse instante, e não no fim, faz o fundo
    // escuro da pergunta entrar enquanto a abertura sai: a página não fica
    // clara entre uma e outra. Sem abertura (reduzir movimento), abre na hora.
    const sumir = document
      .querySelector('.abertura')
      ?.getAnimations()
      .find(
        (animacao) =>
          animacao instanceof CSSAnimation && animacao.animationName === 'abertura-sumir',
      );
    const atraso = Number(sumir?.effect?.getTiming().delay ?? 0);
    const decorrido = Number(sumir?.currentTime ?? 0);
    setTimeout(
      () => {
        dialogo.showModal();
        dialogo
          .querySelector<HTMLButtonElement>(`[data-idioma="${idiomaDaPagina}"]`)
          ?.focus();
      },
      Math.max(0, atraso - decorrido),
    );

    const fechar = () => {
      if (dialogo.open) dialogo.close();
    };
    dialogo.addEventListener('animationend', (evento) => {
      if (evento.animationName === 'pergunta-sair') fechar();
    });

    dialogo.addEventListener('click', (evento) => {
      const alvo = evento.target instanceof Element ? evento.target : null;
      const botao = alvo?.closest<HTMLButtonElement>('[data-idioma]');
      if (!botao) return;
      if (dialogo.classList.contains('saindo')) return;
      const escolhido = botao.dataset.idioma;
      salvar(escolhido);
      const destino =
        escolhido === 'en' ? dialogo.dataset.destinoEn : dialogo.dataset.destinoPt;
      if (escolhido !== idiomaDaPagina && destino) {
        // Vai para outra página: navegar direto, sem esperar a animação.
        dialogo.close();
        location.assign(destino);
        return;
      }
      // Fica na página: some com a saída suave, e não num quadro só.
      dialogo.classList.add('saindo');
      // `animationend` não vem se a animação for cancelada; sem o tempo de
      // reserva, a pergunta ficaria presa na frente da página.
      setTimeout(fechar, 600);
    });

    // Esc fecha e fica no idioma da página, sem perguntar de novo.
    dialogo.addEventListener('cancel', () => salvar(idiomaDaPagina));
  }
</script>

<style>
  /* Entrada suave: o fundo escurece no mesmo ritmo em que a abertura some, e a
     caixa sobe um pouco logo depois. Com "reduzir movimento", a regra global
     de `global.css` zera as durações e a pergunta aparece direto. */
  dialog[open] {
    animation: pergunta-entrar 0.4s cubic-bezier(0.2, 0.7, 0.3, 1) 0.12s both;
  }

  dialog[open]::backdrop {
    animation: pergunta-fundo-entrar 0.35s ease-out both;
  }

  /* Saída suave: o fundo e a caixa somem juntos, mais rápido do que entram. */
  dialog.saindo {
    animation: pergunta-sair 0.25s ease-in both;
  }

  dialog.saindo::backdrop {
    animation: pergunta-fundo-sair 0.25s ease-in both;
  }

  @keyframes pergunta-entrar {
    from {
      opacity: 0;
      transform: translateY(0.75rem) scale(0.97);
    }
  }

  @keyframes pergunta-fundo-entrar {
    from {
      opacity: 0;
    }
  }

  @keyframes pergunta-sair {
    to {
      opacity: 0;
      transform: translateY(0.75rem) scale(0.97);
    }
  }

  @keyframes pergunta-fundo-sair {
    to {
      opacity: 0;
    }
  }
</style>
