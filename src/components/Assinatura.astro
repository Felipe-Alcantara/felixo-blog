---
/**
 * Assinatura dos posts novos via follow.it (pedido do dono, 2026-10-16; ver
 * `docs/superpowers/specs/2026-10-16-assinatura-follow-it-design.md`).
 *
 * `<form>` HTML puro, sem JavaScript: o e-mail vai direto ao follow.it, que
 * confirma a assinatura e manda o aviso quando um post novo entra no
 * `rss.xml`. O blog não guarda e-mail nenhum. Abre o follow.it numa aba nova
 * porque o plano grátis não manda o leitor de volta ao blog.
 *
 * `destaque` (fim do post, home, Sobre) traz título, frase e privacidade;
 * `compacta` (rodapé) é uma linha. Como a mesma página pode ter as duas, os
 * ids vêm do prop `id`, que precisa ser único por instância. Com
 * `FOLLOWIT.formulario` vazio, nada é renderizado.
 */
import { FOLLOWIT } from '../config/site';
import { TEXTOS, type Idioma } from '../config/idiomas';

interface Props {
  idioma: Idioma;
  variante: 'destaque' | 'compacta';
  /** Prefixo dos ids desta instância, ex.: `assinatura-post`. */
  id: string;
  /** Classes de espaçamento do lugar onde entra; somem junto quando desligado. */
  class?: string;
}

const { idioma, variante, id, class: classe } = Astro.props;
const textos = TEXTOS[idioma].assinatura;
const ativo = FOLLOWIT.formulario !== '';
const destaque = variante === 'destaque';
const idEmail = `${id}-email`;
const idAviso = `${id}-aviso`;
---

{
  ativo && (
    <section
      class:list={[
        'assinatura',
        destaque
          ? 'rounded-2xl border border-white/10 bg-black/40 p-6 sm:p-8'
          : 'flex flex-col gap-3',
        classe,
      ]}
      aria-labelledby={destaque ? `${id}-titulo` : undefined}
      aria-label={destaque ? undefined : textos.compacto}
    >
      {destaque && (
        <>
          <h2 id={`${id}-titulo`} class="felixo-text-glow text-xl font-bold">
            {textos.titulo}
          </h2>
          <p class="mt-2 text-zinc-400">{textos.texto}</p>
        </>
      )}

      <form
        action={FOLLOWIT.formulario}
        method="post"
        target="_blank"
        class:list={['flex flex-col gap-2 sm:flex-row sm:items-end', destaque && 'mt-5']}
      >
        <div class="flex-1">
          <label
            for={idEmail}
            class:list={[
              'block text-sm',
              destaque ? 'mb-1.5 text-zinc-300' : 'mb-1 text-zinc-400',
            ]}
          >
            {destaque ? textos.rotuloEmail : textos.compacto}
          </label>
          <input
            id={idEmail}
            type="email"
            name="email"
            required
            autocomplete="email"
            placeholder={textos.placeholder}
            aria-describedby={idAviso}
            class="assinatura-campo w-full"
          />
        </div>
        <button type="submit" class="felixo-botao justify-center">
          <span>{textos.botao}</span>
        </button>
      </form>

      <p
        id={idAviso}
        class:list={['text-xs leading-relaxed text-zinc-400', destaque && 'mt-3']}
      >
        {destaque && <>{textos.privacidade} </>}
        {textos.novaAba}{' '}
        <a
          href={FOLLOWIT.seguir}
          target="_blank"
          rel="noopener noreferrer"
          class="text-zinc-300 underline decoration-white/20 underline-offset-2 transition hover:text-felixo-purple"
        >
          {textos.outrasOpcoes}
        </a>
      </p>
    </section>
  )
}

<style>
  /* Mesmo visual do campo de busca da home (`.felixo-busca input`), sem ícone. */
  .assinatura-campo {
    border-radius: 0.75rem;
    border: 1px solid rgb(255 255 255 / 0.1);
    background: rgb(0 0 0 / 0.4);
    padding: 0.55rem 0.875rem;
    font-size: 0.875rem;
    color: #fff;
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  /* zinc-400, como a busca: o zinc-500 dava 4,35:1 sobre o preto (abaixo do AA). */
  .assinatura-campo::placeholder {
    color: rgb(161 161 170);
  }

  .assinatura-campo:hover,
  .assinatura-campo:focus {
    border-color: rgb(168 85 247 / 0.5);
  }

  .assinatura-campo:focus-visible {
    outline: 2px solid var(--color-felixo-purple);
    outline-offset: 2px;
  }
</style>
