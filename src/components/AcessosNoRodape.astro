---
/**
 * Números de acessos no rodapé de todas as páginas (pedido do dono,
 * 2026-10-22): quantos acessos teve a página em que a pessoa está e o total
 * acumulado do blog, lidos do contador público do GoatCounter, o mesmo que
 * `AcessosDoPost.astro` usa no cabeçalho do post. `TOTAL` é o caminho
 * especial do GoatCounter que soma o site inteiro.
 *
 * O caminho da página é o mesmo que `ContagemDeAcessos.astro` manda na
 * contagem, para o número daqui bater com o do painel. `daPagina` desliga só
 * o número da página: no post ele já aparece no cabeçalho, e na 404 o caminho
 * contado é o de todos os links quebrados juntos. O total aparece sempre.
 *
 * Precisa de "Allow adding visitor counts on your website" ligado no painel.
 * Começa escondido e aparece quando a leitura termina, sempre com os dois
 * números, inclusive 0 (pedido do dono, 2026-10-22: com zero acessos o rodapé
 * não mostrava nada e ele achou que o contador não existia). Para uma página
 * sem nenhum acesso o GoatCounter responde 404 com `count` 0, e isso é um 0
 * de verdade. Quando a leitura falha (bloqueador de anúncio, rede fora,
 * contador desligado), o rodapé mostra uma frase avisando que um bloqueador de
 * anúncio pode estar impedindo (pedido do dono, 2026-10-26; antes era um traço
 * sem explicação), para o contador não parecer ausente. Se qualquer uma das
 * duas leituras falha, a frase substitui os dois números. Sem JavaScript, o
 * rodapé fica como era.
 *
 * O GoatCounter guarda os números em cache por até 4 horas. O separador de
 * milhar vem como espaço ("1 234"): o script fica só com os dígitos e formata
 * no idioma da página.
 */
import { GOATCOUNTER, contaGoatCounter } from '../config/site';
import { TEXTOS, type Idioma } from '../config/idiomas';

interface Props {
  idioma: Idioma;
  /** Mostra também o número da própria página, além do total do blog. */
  daPagina?: boolean;
}

const { idioma, daPagina = true } = Astro.props;
const textos = TEXTOS[idioma];
const ativo = GOATCOUNTER.codigo !== '';
const endereco = (caminho: string) =>
  `${contaGoatCounter()}/counter/${encodeURIComponent(caminho)}.json`;
---

{
  ativo && (
    <p
      hidden
      data-acessos-rodape
      data-pagina={daPagina ? endereco(Astro.url.pathname) : undefined}
      data-total={endereco('TOTAL')}
      data-lang={textos.lang}
      data-rotulos={JSON.stringify(textos.acessosRodape)}
    />
  )
}

<script is:inline>
  document.querySelectorAll('[data-acessos-rodape]').forEach((el) => {
    const rotulos = JSON.parse(el.dataset.rotulos);
    const formatar = new Intl.NumberFormat(el.dataset.lang);

    // Devolve o texto pronto ("1 234 acessos no blog", "0 acessos no blog"), null
    // quando não há endereço (número da página desligado) ou FALHOU. O 404 do
    // GoatCounter traz JSON com `count` 0, então ele passa como resposta; qualquer
    // outra falha é FALHOU.
    const FALHOU = Symbol('falhou');
    const ler = (endereco, rotulo) =>
      endereco
        ? fetch(endereco)
            .then((r) => (r.ok || r.status === 404 ? r.json() : Promise.reject(r.status)))
            .then((dados) => {
              if (dados.count === undefined) return Promise.reject('sem número');
              const n = Number(String(dados.count).replace(/\D/g, ''));
              return `${formatar.format(n)} ${n === 1 ? rotulo.singular : rotulo.plural}`;
            })
            .catch(() => FALHOU)
        : Promise.resolve(null);

    Promise.all([
      ler(el.dataset.pagina, rotulos.pagina),
      ler(el.dataset.total, rotulos.total),
    ]).then((partes) => {
      el.textContent = partes.includes(FALHOU)
        ? rotulos.indisponivel
        : partes.filter(Boolean).join(' · ');
      el.hidden = false;
    });
  });
</script>
