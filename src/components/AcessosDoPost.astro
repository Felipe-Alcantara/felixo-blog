---
/**
 * Número de acessos no cabeçalho do post, lido do contador público do
 * GoatCounter (`/counter/<caminho>.json`). O caminho é o mesmo que
 * `ContagemDeAcessos.astro` manda na contagem. O `PostLayout` só renderiza
 * este componente com `GOATCOUNTER.codigo` preenchido.
 *
 * Exige ligar "Allow adding visitor counts on your website" nas configurações
 * do painel. Começa escondido e aparece quando o número chega, inclusive 0
 * (pedido do dono, 2026-10-22): num post que ainda não teve acesso o
 * GoatCounter responde 404 com `count` 0, e isso é um 0 de verdade. Sem
 * JavaScript o cabeçalho fica como antes. Com a leitura falhando (bloqueador de
 * anúncio, rede fora, contador desligado no painel), ele mostra "acessos
 * indisponíveis (bloqueador de anúncio?)" em vez de sumir (pedido do dono,
 * 2026-10-26: avisar que o bloqueador impede); o rodapé, em
 * `AcessosNoRodape.astro`, faz o mesmo com uma frase inteira. O GoatCounter
 * guarda o número em cache por até 4 horas, então ele não sobe a cada recarga.
 *
 * O separador de milhar do GoatCounter vem como espaço ("1 234"): o script
 * fica só com os dígitos e formata no idioma da página.
 */
import { contaGoatCounter } from '../config/site';
import { TEXTOS, type Idioma } from '../config/idiomas';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const textos = TEXTOS[idioma];
const endereco = `${contaGoatCounter()}/counter/${encodeURIComponent(Astro.url.pathname)}.json`;
---

<span
  class="inline-flex items-center gap-3"
  hidden
  data-acessos={endereco}
  data-singular={textos.acessos.singular}
  data-plural={textos.acessos.plural}
  data-indisponivel={textos.acessos.indisponivel}
  data-lang={textos.lang}
>
  <span aria-hidden="true">·</span>
  <span data-acessos-numero></span>
</span>

<script is:inline>
  document.querySelectorAll('[data-acessos]').forEach((el) => {
    const mostrar = (texto) => {
      el.querySelector('[data-acessos-numero]').textContent = texto;
      el.hidden = false;
    };
    fetch(el.dataset.acessos)
      .then((r) => (r.ok || r.status === 404 ? r.json() : Promise.reject(r.status)))
      .then((dados) => {
        if (dados.count === undefined) return Promise.reject('sem número');
        const n = Number(String(dados.count).replace(/\D/g, ''));
        const numero = new Intl.NumberFormat(el.dataset.lang).format(n);
        mostrar(`${numero} ${n === 1 ? el.dataset.singular : el.dataset.plural}`);
      })
      .catch(() => mostrar(el.dataset.indisponivel));
  });
</script>
