---
/**
 * Conjunto único de ícones do blog.
 *
 * Quase todos vêm do Lucide — a mesma família que o portfólio usa via
 * `lucide-react` — e são desenhados aqui com os mesmos atributos: grid de 24,
 * traço de 2, pontas e junções arredondadas. É essa repetição que faz um
 * conjunto parecer um conjunto, e era justamente ela que se perdia quando cada
 * ícone era colado inline com os seus próprios atributos.
 *
 * As marcas Discord e Twitter não existem no Lucide. Vêm do Font
 * Awesome Free 5.15.4 (https://fontawesome.com, ícones sob CC BY 4.0 —
 * https://fontawesome.com/license/free), os mesmos que o portfólio usa via
 * `react-icons`, e são preenchidas em vez de traçadas, cada uma no seu
 * `viewBox`. Os caminhos do Lucide são os da versão 0.292.0, a do portfólio.
 *
 * Os caminhos entram à mão em vez de virem de um pacote porque o site é
 * estático e sem JavaScript de interface por decisão (ver AGENTS.md): meia
 * dúzia de ícones não paga uma dependência nova.
 *
 * `tamanho` é o tamanho óptico, não um valor livre: 16 acompanha texto (botões,
 * links de navegação), 20 acompanha títulos e 28 é o das redes da home. Sair
 * dessa escala quebra o alinhamento com o peso do traço, que é fixo.
 */
const FORMAS = {
  'seta-baixo': '<path d="M12 5v14" /><path d="m19 12-7 7-7-7" />',
  'seta-esquerda': '<path d="m12 19-7-7 7-7" /><path d="M19 12H5" />',
  'link-externo':
    '<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" /><path d="M15 3h6v6" /><path d="M10 14 21 3" />',
  rss: '<path d="M4 11a9 9 0 0 1 9 9" /><path d="M4 4a16 16 0 0 1 16 16" /><circle cx="5" cy="19" r="1" />',
  busca: '<circle cx="11" cy="11" r="8" /><path d="m21 21-4.3-4.3" />',
  email:
    '<rect width="20" height="16" x="2" y="4" rx="2" /><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />',
  fechar: '<path d="M18 6 6 18" /><path d="m6 6 12 12" />',
  github:
    '<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" /><path d="M9 18c-4.51 2-5-2-7-2" />',
  linkedin:
    '<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" /><rect width="4" height="12" x="2" y="9" /><circle cx="4" cy="4" r="2" />',
} as const;

const MARCAS = {
  discord: {
    viewBox: '0 0 640 512',
    d: 'M524.531,69.836a1.5,1.5,0,0,0-.764-.7A485.065,485.065,0,0,0,404.081,32.03a1.816,1.816,0,0,0-1.923.91,337.461,337.461,0,0,0-14.9,30.6,447.848,447.848,0,0,0-134.426,0,309.541,309.541,0,0,0-15.135-30.6,1.89,1.89,0,0,0-1.924-.91A483.689,483.689,0,0,0,116.085,69.137a1.712,1.712,0,0,0-.788.676C39.068,183.651,18.186,294.69,28.43,404.354a2.016,2.016,0,0,0,.765,1.375A487.666,487.666,0,0,0,176.02,479.918a1.9,1.9,0,0,0,2.063-.676A348.2,348.2,0,0,0,208.12,430.4a1.86,1.86,0,0,0-1.019-2.588,321.173,321.173,0,0,1-45.868-21.853,1.885,1.885,0,0,1-.185-3.126c3.082-2.309,6.166-4.711,9.109-7.137a1.819,1.819,0,0,1,1.9-.256c96.229,43.917,200.41,43.917,295.5,0a1.812,1.812,0,0,1,1.924.233c2.944,2.426,6.027,4.851,9.132,7.16a1.884,1.884,0,0,1-.162,3.126,301.407,301.407,0,0,1-45.89,21.83,1.875,1.875,0,0,0-1,2.611,391.055,391.055,0,0,0,30.014,48.815,1.864,1.864,0,0,0,2.063.7A486.048,486.048,0,0,0,610.7,405.729a1.882,1.882,0,0,0,.765-1.352C623.729,277.594,590.933,167.465,524.531,69.836ZM222.491,337.58c-28.972,0-52.844-26.587-52.844-59.239S193.056,219.1,222.491,219.1c29.665,0,53.306,26.82,52.843,59.239C275.334,310.993,251.924,337.58,222.491,337.58Zm195.38,0c-28.971,0-52.843-26.587-52.843-59.239S388.437,219.1,417.871,219.1c29.667,0,53.307,26.82,52.844,59.239C470.715,310.993,447.538,337.58,417.871,337.58Z',
  },
  twitter: {
    viewBox: '0 0 512 512',
    d: 'M459.37 151.716c.325 4.548.325 9.097.325 13.645 0 138.72-105.583 298.558-298.558 298.558-59.452 0-114.68-17.219-161.137-47.106 8.447.974 16.568 1.299 25.34 1.299 49.055 0 94.213-16.568 130.274-44.832-46.132-.975-84.792-31.188-98.112-72.772 6.498.974 12.995 1.624 19.818 1.624 9.421 0 18.843-1.3 27.614-3.573-48.081-9.747-84.143-51.98-84.143-102.985v-1.299c13.969 7.797 30.214 12.67 47.431 13.319-28.264-18.843-46.781-51.005-46.781-87.391 0-19.492 5.197-37.36 14.294-52.954 51.655 63.675 129.3 105.258 216.365 109.807-1.624-7.797-2.599-15.918-2.599-24.04 0-57.828 46.782-104.934 104.934-104.934 30.213 0 57.502 12.67 76.67 33.137 23.715-4.548 46.456-13.32 66.599-25.34-7.798 24.366-24.366 44.833-46.132 57.827 21.117-2.273 41.584-8.122 60.426-16.243-14.292 20.791-32.161 39.308-52.628 54.253z',
  },
} as const;

export type NomeDeIcone = keyof typeof FORMAS | keyof typeof MARCAS;

interface Props {
  nome: NomeDeIcone;
  /** Tamanho óptico em px: 16 junto de texto, 20 junto de título, 28 nas redes. */
  tamanho?: 16 | 20 | 28;
  class?: string;
}

const { nome, tamanho = 16, class: classe } = Astro.props;
const marca = nome in MARCAS ? MARCAS[nome as keyof typeof MARCAS] : undefined;
---

{
  marca ? (
    <svg
      aria-hidden="true"
      focusable="false"
      width={tamanho}
      height={tamanho}
      viewBox={marca.viewBox}
      fill="currentColor"
      class={classe}
    >
      <path d={marca.d} />
    </svg>
  ) : (
    <svg
      aria-hidden="true"
      focusable="false"
      width={tamanho}
      height={tamanho}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class={classe}
    >
      <Fragment set:html={FORMAS[nome as keyof typeof FORMAS]} />
    </svg>
  )
}
