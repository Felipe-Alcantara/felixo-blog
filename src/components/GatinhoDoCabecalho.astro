---
/**
 * O gatinho do cabeçalho (decisão do dono, 2026-10-26, depois de a regra 2.2.2
 * do WCAG apontar o loop infinito que ele tinha desde 2026-10-16): fica parado
 * e dá 3 piscadas completas quando o mouse ou o foco do teclado chega no nome
 * do blog. As 3 piscadas terminam mesmo que o mouse saia. No celular o toque já
 * leva para a home, então lá ele fica parado; e também fica parado com
 * "reduzir movimento" no sistema ou com o botão "Pausar animações" do rodapé.
 *
 * É uma cópia do desenho do `Abertura.astro` e do SVG original do dono em
 * `public/imagens/gatinho-piscando-headbang.svg` (que continua lá, sem
 * retoque). Inline, e não `<img>`, porque o CSS da página não alcança o que
 * está dentro de uma imagem SVG, e o gatinho precisa começar e parar por
 * evento. Por isso o `id` do gradiente tem outro nome: o `gatinho-rosa` é do
 * SVG da abertura, e o mesmo `id` duas vezes na página é HTML inválido.
 *
 * Os `@keyframes` `gatinho-*` vêm do `Abertura.astro`, que está em toda página
 * (o desenho é o mesmo, no mesmo `viewBox`). Renomear ou apagar lá exige
 * mexer aqui também.
 */
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 1932 1932"
  class="gatinho size-8 shrink-0 transition group-hover:drop-shadow-[0_0_10px_rgba(168,85,247,0.6)]"
  aria-hidden="true"
  focusable="false"
  data-gatinho-cabecalho
>
  <defs>
    <linearGradient
      id="gatinho-rosa-cabecalho"
      gradientUnits="userSpaceOnUse"
      x1="0"
      y1="345"
      x2="0"
      y2="1590"
    >
      <stop offset="0" stop-color="#DB749D"></stop>
      <stop offset="1" stop-color="#CE2055"></stop>
    </linearGradient>
  </defs>

  <g class="gatinho__parte gatinho__cabeca">
    <!-- rosto branco (segue o contorno e o zigue-zague dos bigodes) -->
    <path
      fill="#fff"
      d="M395 1384 L310 1383.5 L395 1278.5 L210 1263.5 L360 1155.5 L215 1093.5 L303.5 1051
      C341.5 1000 359.5 930 349 855 C332 740 331.5 640 340.5 576 C346.5 442 421.5 367.5 490.5 367.5
      C515.5 367.5 530.5 373.5 548.5 385.5 C640.5 441.5 720 506.5 797 568.5 C860 546.5 910 539.5 966 539.5
      C1022 539.5 1072 546.5 1135 568.5 C1212 506.5 1291.5 441.5 1383.5 385.5 C1401.5 373.5 1416.5 367.5 1441.5 367.5
      C1510.5 367.5 1585.5 442 1591.5 576 C1600.5 640 1600 740 1583 855 C1572.5 930 1590.5 1000 1628.5 1051
      L1717 1093.5 L1572 1155.5 L1722 1263.5 L1537 1278.5 L1622 1383.5 L1537 1384
      C1372 1520 1172 1563 966 1563 C760 1563 560 1520 395 1384 Z"
    ></path>

    <g
      fill="none"
      stroke="url(#gatinho-rosa-cabecalho)"
      stroke-width="42"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <!-- contorno: bochecha esquerda, orelhas, topo da cabeça, bochecha direita -->
      <path
        d="M303.5 1051 C341.5 1000 359.5 930 349 855 C332 740 331.5 640 340.5 576 C346.5 442 421.5 367.5 490.5 367.5
        C515.5 367.5 530.5 373.5 548.5 385.5 C640.5 441.5 720 506.5 797 568.5 C860 546.5 910 539.5 966 539.5
        C1022 539.5 1072 546.5 1135 568.5 C1212 506.5 1291.5 441.5 1383.5 385.5 C1401.5 373.5 1416.5 367.5 1441.5 367.5
        C1510.5 367.5 1585.5 442 1591.5 576 C1600.5 640 1600 740 1583 855 C1572.5 930 1590.5 1000 1628.5 1051"
      ></path>
      <!-- queixo -->
      <path d="M395 1386 C560 1520 760 1563 966 1563 C1172 1563 1372 1520 1537 1386"
      ></path>
      <!-- bigodes -->
      <polyline
        points="365,1033.5 215,1093.5 360,1155.5 210,1263.5 395,1278.5 310,1383.5 480,1364.5"
      ></polyline>
      <polyline
        points="1567,1033.5 1717,1093.5 1572,1155.5 1722,1263.5 1537,1278.5 1622,1383.5 1452,1364.5"
      ></polyline>
    </g>

    <!-- parte de dentro das orelhas (encolhe quando as orelhas tombam para frente) -->
    <g class="gatinho__parte gatinho__orelhas" fill="url(#gatinho-rosa-cabecalho)">
      <path
        d="M456 819.5 C421 731 411 621 426 556 C439 501 460.5 482.5 478.5 482.5 C496 482.5 511.5 493 526.5 508 L659 651 C592 691.5 521.5 751.5 456 819.5 Z"
      ></path>
      <path
        d="M1476 819.5 C1511 731 1521 621 1506 556 C1493 501 1471.5 482.5 1453.5 482.5 C1436 482.5 1420.5 493 1405.5 508 L1273 651 C1340 691.5 1410.5 751.5 1476 819.5 Z"
      ></path>
    </g>

    <!-- olhos e boca (ficam "na frente": descem mais que o contorno) -->
    <g class="gatinho__parte gatinho__frente">
      <g fill="url(#gatinho-rosa-cabecalho)">
        <!-- olho direito do gatinho (lado esquerdo da tela): é o que pisca -->
        <ellipse
          class="gatinho__parte gatinho__olho--pisca"
          cx="674"
          cy="1085"
          rx="111"
          ry="146"></ellipse>
        <ellipse cx="1258" cy="1085" rx="111" ry="146"></ellipse>
        <!-- olho piscando: arquinho ⌒ -->
        <path
          class="gatinho__parte gatinho__olho-fechado"
          stroke="url(#gatinho-rosa-cabecalho)"
          stroke-width="18"
          stroke-linejoin="round"
          d="M566 1112 C598 1032 750 1032 782 1112 C744 1072 604 1072 566 1112 Z"></path>
      </g>
      <!-- boquinha -->
      <path
        class="gatinho__parte gatinho__boca"
        fill="none"
        stroke="url(#gatinho-rosa-cabecalho)"
        stroke-width="33"
        stroke-linejoin="round"
        d="M899 1270 C899 1320 940 1345 966 1353 C992 1345 1033 1320 1033 1270"></path>
    </g>
  </g>
</svg>

<style>
  /* Pivôs das partes, em unidades do `viewBox` (os mesmos do `Abertura.astro`). */
  .gatinho__cabeca {
    transform-origin: 966px 1560px;
  }
  .gatinho__frente {
    transform-origin: 966px 1150px;
  }
  .gatinho__orelhas {
    transform-origin: 966px 820px;
  }
  .gatinho__olho--pisca,
  .gatinho__olho-fechado,
  .gatinho__boca {
    transform-box: fill-box;
    transform-origin: center;
  }
  .gatinho__olho-fechado {
    opacity: 0;
  }

  /* Em repouso nada se mexe. O script põe `piscando` e tira no fim: um ciclo de
     3,5 s tem a piscadinha nos primeiros 40% e o resto é pausa, e são 3 ciclos. */
  .gatinho.piscando .gatinho__parte {
    animation-duration: 3.5s;
    animation-iteration-count: 3;
    animation-fill-mode: both;
  }
  .gatinho.piscando .gatinho__cabeca {
    animation-name: gatinho-headbang;
  }
  .gatinho.piscando .gatinho__frente {
    animation-name: gatinho-headbang-frente;
  }
  .gatinho.piscando .gatinho__orelhas {
    animation-name: gatinho-headbang-orelhas;
  }
  .gatinho.piscando .gatinho__olho--pisca {
    animation-name: gatinho-olho-abre-fecha;
  }
  .gatinho.piscando .gatinho__olho-fechado {
    animation-name: gatinho-olho-fechado;
  }
  .gatinho.piscando .gatinho__boca {
    animation-name: gatinho-sorri;
  }

  /* Cinto e suspensório: o script já não começa a piscar nestes dois casos. */
  @media (prefers-reduced-motion: reduce) {
    .gatinho .gatinho__parte {
      animation: none !important;
    }
  }
  :global(html[data-animacoes='pausadas']) .gatinho .gatinho__parte {
    animation: none !important;
  }
</style>

<script>
  const marca = document.querySelector<HTMLAnchorElement>('[data-marca]');
  const gato = marca?.querySelector<SVGElement>('[data-gatinho-cabecalho]');

  if (marca && gato) {
    const parado = () =>
      document.documentElement.dataset.animacoes === 'pausadas' ||
      matchMedia('(prefers-reduced-motion: reduce)').matches;
    const piscar = () => {
      if (!parado()) gato.classList.add('piscando');
    };

    // Só mouse e caneta: no toque, o mesmo gesto já leva para a home.
    marca.addEventListener('pointerenter', (evento) => {
      if (evento.pointerType !== 'touch') piscar();
    });
    // Só o foco de teclado; o foco que vem do clique do mouse não conta.
    marca.addEventListener('focus', () => {
      if (marca.matches(':focus-visible')) piscar();
    });

    // As 3 piscadas vão até o fim mesmo que o mouse saia; a classe sai no fim
    // (ou quando o botão "Pausar animações" corta a animação), e a próxima
    // chegada pisca de novo. A cabeça é a parte que serve de relógio.
    const terminou = (evento: AnimationEvent) => {
      if (evento.animationName === 'gatinho-headbang') gato.classList.remove('piscando');
    };
    gato.addEventListener('animationend', terminou);
    gato.addEventListener('animationcancel', terminou);
  }
</script>
