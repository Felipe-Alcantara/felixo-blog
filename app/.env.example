# Copie para `.env` (nunca commitado — ver .gitignore da raiz) e preencha.
# Mesmo padrão do projeto Automações do Notion: token de integração interna.

# Criado em https://www.notion.so/my-integrations.
# Depois de criar, compartilhe a database "Artigos" com a integração.
NOTION_TOKEN=

# ID da database "Artigos" do Notion (32 caracteres, sem hífen ou com).
NOTION_DATABASE_ID=
